{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.1"}
        org.clojure/data.json {:mvn/version "2.5.1"}
        nrepl/nrepl {:mvn/version "1.3.1"}}
 :aliases
 {:dev {:main-opts ["-m" "gpui.dev"]}
  :test {:extra-paths ["test" "examples/themes/catppuccin-violet/src"]
         :main-opts ["-m" "gpui.test-runner"]}
  :protocol-test {:extra-paths ["test"]
                  :main-opts ["-m" "gpui.dev" "--protocol-test" "gpui.test-app/app"]}
  :cljfmt {:extra-deps {dev.weavejester/cljfmt {:mvn/version "0.16.5"}}
           :main-opts ["-m" "cljfmt.main"]}
  :connect {:main-opts ["-m" "nrepl.cmdline"
                        "--connect"
                        "--host" "127.0.0.1"
                        "--port" "7888"]}}}
