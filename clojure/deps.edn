{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.1"}
        org.clojure/data.json {:mvn/version "2.5.1"}
        nrepl/nrepl {:mvn/version "1.3.1"}}
 :aliases
 {:run {:main-opts ["-m" "gpui.runtime"]}
  :test {:extra-paths ["test"]
         :main-opts ["-m" "gpui.test-runner"]}
  :connect {:main-opts ["-m" "nrepl.cmdline"
                        "--connect"
                        "--host" "127.0.0.1"
                        "--port" "7888"]}}}
